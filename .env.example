# Telegram — never commit a real token.
BOT_TOKEN=PASTE_NEW_TOKEN_FROM_BOTFATHER
ADMIN_ID=123456789
CHANNEL_MUSIC=@your_music_channel
CHANNEL_VIDEO=@your_video_channel
BOT_USERNAME=@your_bot_username

# Security
CHANNEL_COMMANDS_ADMIN_ONLY=true
STRICT_CHANNEL_CHECK=true
COLLECT_USER_CONTACT_DATA=false
USER_PRIVATE_CHAT_ONLY=true
ADMIN_PRIVATE_CHAT_ONLY=true
SECURITY_DEFAULT_ACCESS_MODE=public
# SECURITY_WHITELIST_IDS=123456789,987654321

# Persistent paths. /data is in Docker; use relative paths for a local Windows run.
MUSIC_DIR=/data/music
VIDEO_DIR=/data/video
DOWNLOADS_DIR=/data/downloads
TEMP_DIR=/data/temp
LOG_DIR=/data/logs
USERS_DB=/data/users.db
SONGS_DB=/data/songs.db
SEARCH_RESULTS_DB=/data/search_results.db

# Resource limits suitable for a small free VM
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_FFMPEG=1
MAX_CONCURRENT_YOUTUBE=2
MAX_ACTIVE_DOWNLOADS_PER_USER=1
MAX_QUEUE_SIZE=20
MAX_GLOBAL_QUEUE_SIZE=50
SECURITY_MAX_QUEUE_SIZE_PER_USER=10
SECURITY_MAX_GLOBAL_QUEUE_SIZE=50
MAX_SEARCH_RESULTS=50
MAX_PLAYLIST_RESULTS=250
RESULTS_PAGE_SIZE=10
MAX_QUERY_LENGTH=200
SEARCH_COOLDOWN_SECONDS=2
SEARCH_MEMORY_CACHE_SIZE=64

# Storage and cleanup
MAX_SEGMENT_SIZE=51380224
MIN_DISK_SPACE_MB=512
BOT_STORAGE_QUOTA_GB=15
SYSTEM_FREE_RESERVE_GB=5
MIN_DOWNLOAD_RESERVATION_MB=256
UNKNOWN_DOWNLOAD_RESERVATION_MB=1024
FILE_RETENTION_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=3600
SEARCH_CACHE_TTL_HOURS=24

# Network retries
YTDLP_SOCKET_TIMEOUT=30
TELEGRAM_REQUEST_TIMEOUT=120
TELEGRAM_SEND_RETRIES=3
TELEGRAM_RETRY_BASE_SECONDS=1

